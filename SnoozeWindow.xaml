<Window x:Class="SleepReminder.SnoozeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="延后倒计时"
        WindowStyle="None"
        WindowState="Normal"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="380" Height="215"
        WindowStartupLocation="Manual"
        Background="#333333"
        AllowsTransparency="False">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="txtCountdown"
                   Text="10:00"
                   FontSize="48"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"/>
        <!-- 固定额度倒计时：本夜固定额度的真实余额，随本次延后一起逐秒递减 -->
        <TextBlock x:Name="txtFixedQuota"
                   Text=""
                   FontSize="22"
                   Foreground="#ffcc00"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"
                   Margin="16,4,16,0"/>
        <!-- 附加池余额（同样实时投影）与本夜类型 / 系数 -->
        <TextBlock x:Name="txtQuota"
                   Text=""
                   FontSize="13"
                   Foreground="#cccccc"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="16,8,16,0"/>
    </StackPanel>
</Window>
