<Window x:Class="SleepReminder.SnoozeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="延后倒计时"
        WindowStyle="None"
        WindowState="Normal"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="360" Height="170"
        WindowStartupLocation="Manual"
        Background="#333333"
        AllowsTransparency="False">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="txtCountdown"
                   Text="10:00"
                   FontSize="48"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"/>
        <!-- 额度摘要：本夜固定剩余 / 本周附加剩余 / 夜的类型与系数 -->
        <TextBlock x:Name="txtQuota"
                   Text=""
                   FontSize="13"
                   Foreground="#cccccc"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="16,10,16,0"/>
    </StackPanel>
</Window>
