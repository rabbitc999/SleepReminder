<Window x:Class="SleepReminder.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提醒外观设置"
        Width="620" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Topmost="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="提醒外观设置"
                       Foreground="#ffcc00"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock Text="让霸屏提醒页不再干巴巴——背景图、标题、条目都可以换成你自己的。"
                       Foreground="#bbbbbb"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- 背景图片 -->
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="背景图片（可选，建议 1920×1080 及以上）"
                       Foreground="White" FontSize="14" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtImagePath" Grid.Column="0" Height="32" FontSize="13"
                         VerticalContentAlignment="Center" TextChanged="ImagePath_TextChanged"/>
                <Button x:Name="btnBrowse" Grid.Column="1" Content="浏览…" Width="80" Height="32" Margin="8,0,0,0"
                        Foreground="White" Background="#37474F" BorderBrush="#546E7A" BorderThickness="1"
                        Cursor="Hand" Click="Browse_Click"/>
                <Button x:Name="btnClearImage" Grid.Column="2" Content="清除" Width="64" Height="32" Margin="8,0,0,0"
                        Foreground="White" Background="#37474F" BorderBrush="#546E7A" BorderThickness="1"
                        Cursor="Hand" Click="ClearImage_Click"/>
            </Grid>
        </StackPanel>

        <!-- 预览 -->
        <Border Grid.Row="2" Height="150" Margin="0,12,0,0"
                Background="#111111" BorderBrush="#444444" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Image x:Name="imgPreview" Stretch="Uniform" Margin="6"/>
                <TextBlock x:Name="tbPreviewHint"
                           Foreground="#888888" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 大标题 -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="大标题（默认“快去睡觉”）" Foreground="White" FontSize="14" Margin="0,0,0,6"/>
            <TextBox x:Name="txtTitle" Height="32" FontSize="14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- 条目区小标题 -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="条目区小标题（默认“晚睡的危害”，留空则不显示）"
                       Foreground="White" FontSize="14" Margin="0,0,0,6"/>
            <TextBox x:Name="txtTipsHeader" Height="32" FontSize="14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- 条目正文 -->
        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock Text="提醒条目（每行一条）" Foreground="White" FontSize="14" Margin="0,0,0,6"/>
            <TextBox x:Name="txtTips" FontSize="14"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="170"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="btnReset" Content="恢复默认" Width="100" Height="38" Margin="0,0,10,0"
                    Foreground="White" Background="#6D4C41" BorderBrush="#4E342E" BorderThickness="1"
                    Cursor="Hand" Click="Reset_Click"/>
            <Button x:Name="btnCancel" Content="取消" Width="90" Height="38" Margin="0,0,10,0"
                    Foreground="White" Background="#37474F" BorderBrush="#546E7A" BorderThickness="1"
                    Cursor="Hand" Click="Cancel_Click"/>
            <Button x:Name="btnOk" Content="确定" Width="90" Height="38"
                    Foreground="White" Background="#1565C0" BorderBrush="#0D47A1" BorderThickness="1"
                    Cursor="Hand" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
