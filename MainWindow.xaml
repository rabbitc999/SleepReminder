<Window x:Class="SleepReminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SleepReminder" 
        WindowStyle="None" 
        WindowState="Maximized" 
        Topmost="True" 
        ShowInTaskbar="False" 
        Background="#1a1a1a" Width="1920" Height="1078">
    <Grid>
        <!-- 定义 2 行，3 列 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 背景层：自定义图片（可选）。未设置时保持窗口纯色背景 -->
        <Image x:Name="imgWarningBackground"
               Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3"
               Stretch="UniformToFill"
               Visibility="Collapsed"/>
        <!-- 半透明遮罩：有背景图时压暗一层，保证前景文字始终清晰可读 -->
        <Rectangle x:Name="rectWarningOverlay"
                   Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3"
                   Fill="#B3000000"
                   Visibility="Collapsed"/>

        <!-- 主警告：跨两列？实际跨三列，居中显示 -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" 
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            Margin="0,0,0,20">

            <!-- 左侧警告三角 -->
            <!-- 左侧警告三角 -->
            <Viewbox Width="140" Height="140" Margin="20,0">
                <Grid Width="80" Height="80">
                    <Path Fill="Yellow" 
              Stroke="Black" 
              StrokeThickness="3"
              Data="M 40,0 L 10,70 A 12,12 0 0,0 20,80 L 60,80 A 12,12 0 0,0 70,70 Z"/>
                    <TextBlock Text="!" 
                   FontSize="60" 
                   FontWeight="Black" 
                   Foreground="Black" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Margin="0,10,0,0"/>
                </Grid>
            </Viewbox>

            <!-- 中间文字 -->
            <TextBlock x:Name="txtWarningTitle"
               Text="快去睡觉" 
               FontSize="80" 
               Foreground="Red" 
               FontWeight="Bold" 
               Margin="20,0"
               VerticalAlignment="Center"/>

            <!-- 右侧警告三角（与左侧对称） -->
            <!-- 左侧警告三角 -->
            <Viewbox Width="140" Height="140" Margin="20,0">
                <Grid Width="80" Height="80">
                    <Path Fill="Yellow" 
              Stroke="Black" 
              StrokeThickness="3"
              Data="M 40,0 L 10,70 A 12,12 0 0,0 20,80 L 60,80 A 12,12 0 0,0 70,70 Z"/>
                    <TextBlock Text="!" 
                   FontSize="60" 
                   FontWeight="Black" 
                   Foreground="Black" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Margin="0,10,0,0"/>
                </Grid>
            </Viewbox>
        </StackPanel>

        <!-- 晚睡危害：跨三列，居中显示（条目正文运行时按“提醒外观设置”生成） -->
        <StackPanel x:Name="spWarningTips"
                    Grid.Row="1" Grid.ColumnSpan="3" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Margin="0,0,0,40">
            <TextBlock x:Name="tbTipsHeader"
                       Text="晚睡的危害" 
                       FontSize="36" 
                       Foreground="#ffcc00" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- 延后按钮：左上角 (Row0, Col0) -->
        <Button Grid.Row="0" Grid.Column="0" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="30,30,0,0"
                Width="150" Height="50" 
                FontSize="20" FontWeight="Bold"
                Foreground="White" Background="#2E7D32" 
                BorderBrush="#1B5E20" BorderThickness="2"
                Cursor="Hand"
                Click="SnoozeButton_Click"
                Content="延后保存数据"/>

        <!-- 额度摘要：右上角 (Row0, Col2)，进入提醒时刷新 -->
        <TextBlock x:Name="txtQuotaHint"
                   Grid.Row="0" Grid.Column="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,34,30,0"
                   FontSize="16"
                   Foreground="#9E9E9E"
                   TextAlignment="Right"
                   Text=""/>

        <!-- 退出按钮已移除：本程序不提供任何界面退出入口 -->
        <!-- 关机按钮：右下角 (Row1, Col2) -->
        <Button Grid.Row="1" Grid.Column="2" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,30,30"
                Width="150" Height="50" 
                FontSize="24" FontWeight="Bold"
                Foreground="White" Background="#D32F2F" 
                BorderBrush="#FF6F00" BorderThickness="2"
                Cursor="Hand"
                Click="ShutdownButton_Click"
                Content="关机"/>
    </Grid>
</Window>