<Window x:Class="SleepReminder.QuotaSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="额度设置"
        Width="540" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Topmost="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="额度设置"
                       Foreground="#ffcc00"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock Text="延后即“借款”，从这里扣。参数直接决定惩罚力度，因此每个自然周只能修改一次。"
                       Foreground="#bbbbbb"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="作息周制" Width="180" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbPattern" Width="240" Height="32" FontSize="14">
                    <ComboBoxItem Content="双休（周六、周日都休）"/>
                    <ComboBoxItem Content="单休（只休周日）"/>
                    <ComboBoxItem Content="大小周（大周双休 / 小周单休）"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="固定额度（分钟 / 夜）" Width="180" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="txtFixed" Width="240" Height="32" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="附加池（分钟 / 周）" Width="180" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPool" Width="240" Height="32" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="宽松夜系数（0.1 ~ 1.0）" Width="180" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="txtFactor" Width="240" Height="32" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="紧张夜单夜封顶（分钟）" Width="180" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCapWork" Width="240" Height="32" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="宽松夜单夜封顶（分钟）" Width="180" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCapRelax" Width="240" Height="32" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>

            <CheckBox x:Name="chkOverdraft"
                      Content="附加池耗尽后允许透支（透支额转为债务）"
                      Foreground="White"
                      FontSize="14"
                      Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock x:Name="tbLock"
                   Grid.Row="2"
                   Foreground="#9E9E9E"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="btnOk" Content="确定" Width="90" Height="38" Margin="0,0,10,0"
                    Foreground="White" Background="#1565C0" BorderBrush="#0D47A1" BorderThickness="1"
                    Cursor="Hand" Click="Ok_Click"/>
            <Button x:Name="btnCancel" Content="取消" Width="90" Height="38"
                    Foreground="White" Background="#37474F" BorderBrush="#546E7A" BorderThickness="1"
                    Cursor="Hand" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
