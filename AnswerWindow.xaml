<Window x:Class="SleepReminder.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="验证身份 - 请完成所有题目" 
        WindowStyle="None" 
        WindowState="Normal" 
        Topmost="True" 
        ResizeMode="NoResize"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#2a2a2a">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 普通题区域（初始可见） -->
        <ScrollViewer x:Name="svNormal" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel x:Name="spQuestions" Margin="5"/>
        </ScrollViewer>

        <!-- Boss题区域（初始隐藏）  -->
        <ScrollViewer x:Name="svBoss" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="10">
            <StackPanel x:Name="spBoss" Margin="5">
                <TextBlock x:Name="tbBossQuestion" Text="" FontSize="24" Foreground="Yellow" 
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" TextWrapping="Wrap"/>
                <TextBlock Text="说明：质数是指大于1的自然数，除了1和它本身外，不能被其他自然数整除的数。例如：2、3、5、7、11、13 等都是质数。" 
                           FontSize="16" Foreground="LightBlue" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="txtBossAnswer" Width="150" Height="40" FontSize="20"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Background="#333" Foreground="White" BorderBrush="#555"/>
                    <Button x:Name="btnBossSubmit" Content="提交" Width="80" Height="40" 
                            FontSize="20" FontWeight="Bold" Foreground="White" Background="#F57C00"
                            Margin="10,0,0,0" Click="BossSubmit_Click"/>
                </StackPanel>
                <TextBlock x:Name="tbBossResult" Text="" FontSize="18" Foreground="Red" 
                           HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="btnSubmit" 
                    Content="提交所有普通题" 
                    Width="140" Height="35" 
                    FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#1976D2" 
                    Click="SubmitButton_Click"/>
            <Button x:Name="btnCancel" 
                    Content="取消" 
                    Width="80" Height="35" 
                    Margin="15,0,0,0"
                    Click="CancelButton_Click"/>
        </StackPanel>
        <TextBlock x:Name="tbResult" 
                   Grid.Row="2" 
                   Text="" 
                   FontSize="18" 
                   Foreground="Red" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,10"
                   Visibility="Collapsed"/>
    </Grid>
</Window>