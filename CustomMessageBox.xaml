<Window x:Class="SleepReminder.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        WindowStyle="None"
        WindowState="Normal"
        Topmost="True"
        ResizeMode="NoResize"
        Width="450" Height="200"
        WindowStartupLocation="CenterOwner"
        Background="#2a2a2a"
        AllowsTransparency="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock x:Name="tbTitle" Grid.Row="0" 
                   Text="提示" 
                   FontSize="20" FontWeight="Bold"
                   Foreground="#ffcc00" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"/>

        <!-- 内容 -->
        <TextBlock x:Name="tbMessage" Grid.Row="1" 
                   Text="" 
                   FontSize="18" 
                   Foreground="White" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnLeft" Content="确定" 
                    Width="100" Height="35" Margin="5"
                    FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#1976D2"
                    Click="Button_Click" Tag="left"/>
            <Button x:Name="btnRight" Content="取消" 
                    Width="100" Height="35" Margin="5"
                    FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#7B1FA2"
                    Click="Button_Click" Tag="right"/>
        </StackPanel>
    </Grid>
</Window>