<Window x:Class="SleepReminder.SetTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置提醒时间区间" 
        Height="280" Width="320" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="请选择提醒时间区间" FontSize="16" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <!-- 开始时间 -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="开始：" FontSize="14" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="cmbStartHour" Width="60" Margin="5" SelectedIndex="23"/>
                <TextBlock Text=":" FontSize="20" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbStartMinute" Width="60" Margin="5" SelectedIndex="0"/>
            </WrapPanel>

            <!-- 结束时间 -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,5">
                <TextBlock Text="结束：" FontSize="14" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="cmbEndHour" Width="60" Margin="5" SelectedIndex="23"/>
                <TextBlock Text=":" FontSize="20" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbEndMinute" Width="60" Margin="5" SelectedIndex="59"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="确定" Width="80" Margin="5" IsDefault="True" Click="OkButton_Click"/>
                <Button Content="取消" Width="80" Margin="5" IsCancel="True" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>