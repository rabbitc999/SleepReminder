<Window x:Class="SleepReminder.QuotaPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="额度与作息预览"
        Width="980" Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Topmost="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="额度与作息预览"
                       Foreground="#ffcc00"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock x:Name="tbSubtitle"
                       Foreground="#bbbbbb"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左：额度 ===== -->
            <Border Grid.Column="0"
                    Background="#242424" BorderBrush="#444444" BorderThickness="1"
                    CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="额度" Foreground="#ffcc00"
                                   FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="tbQuota" Foreground="White" FontSize="13"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="近 7 夜明细" Foreground="#ffcc00"
                                   FontSize="14" FontWeight="Bold" Margin="0,18,0,0"/>
                        <StackPanel x:Name="spNights" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 右：作息 ===== -->
            <Border Grid.Column="2"
                    Background="#242424" BorderBrush="#444444" BorderThickness="1"
                    CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="近期作息" Foreground="#ffcc00"
                                   FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="tbRestHint" Foreground="#999999" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <StackPanel x:Name="spDays" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnRefresh" Content="刷新" Width="90" Height="38" Margin="0,0,10,0"
                    Foreground="White" Background="#37474F" BorderBrush="#546E7A" BorderThickness="1"
                    Cursor="Hand" Click="Refresh_Click"/>
            <Button x:Name="btnExit" Content="退出程序" Width="110" Height="38" Margin="0,0,10,0"
                    Foreground="White" Background="#D32F2F" BorderBrush="#B71C1C" BorderThickness="1"
                    Cursor="Hand" Click="Exit_Click"/>
            <Button x:Name="btnClose" Content="关闭" Width="90" Height="38"
                    IsCancel="True"
                    Foreground="White" Background="#1565C0" BorderBrush="#0D47A1" BorderThickness="1"
                    Cursor="Hand" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
