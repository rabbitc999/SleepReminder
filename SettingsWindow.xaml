<Window x:Class="SleepReminder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="600" Height="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="设置"
                       Foreground="#ffcc00"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock Text="提醒时间与延后时长随时可改；额度与周制每个自然周只能改一次。"
                       Foreground="#bbbbbb"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>

                <!-- ===== 提醒时间 ===== -->
                <Border Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="提醒时间（随时可改）"
                                   Foreground="#ffcc00" FontSize="14" FontWeight="Bold"/>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Text="开始：" Foreground="White" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cmbStartHour" Width="64" Height="30" FontSize="13"/>
                            <TextBlock Text=":" Foreground="White" FontSize="16"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <ComboBox x:Name="cmbStartMinute" Width="64" Height="30" FontSize="13"/>

                            <TextBlock Text="结束：" Foreground="White" FontSize="14"
                                       VerticalAlignment="Center" Margin="24,0,6,0"/>
                            <ComboBox x:Name="cmbEndHour" Width="64" Height="30" FontSize="13"/>
                            <TextBlock Text=":" Foreground="White" FontSize="16"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <ComboBox x:Name="cmbEndMinute" Width="64" Height="30" FontSize="13"/>
                        </WrapPanel>
                        <TextBlock Text="区间可跨零点，例如 23:30 ~ 06:00；开始时刻同时也是“夜”的分界点。"
                                   Foreground="#999999" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===== 延后时长 ===== -->
                <Border Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6"
                        Padding="14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="延后时长（随时可改）"
                                   Foreground="#ffcc00" FontSize="14" FontWeight="Bold"/>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Text="单次延后 " Foreground="White" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbSnoozeMinutes" Width="80" Height="30" FontSize="13"/>
                            <TextBlock Text=" 分钟（5 ~ 15）" Foreground="White" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Text="实际能延后多久还受当夜额度限制；额度不足时会按剩余额度自动缩减。"
                                   Foreground="#999999" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===== 额度与周制 ===== -->
                <Border Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6"
                        Padding="14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="额度与周制（每自然周只能改一次）"
                                   Foreground="#ffcc00" FontSize="14" FontWeight="Bold"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="作息周制"
                                       Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <ComboBox x:Name="cmbPattern" Grid.Row="0" Grid.Column="1"
                                      Height="30" FontSize="13" Margin="0,0,0,10">
                                <ComboBoxItem Content="双休（周六、周日都休）"/>
                                <ComboBoxItem Content="单休（只休周日）"/>
                                <ComboBoxItem Content="大小周（大周双休 / 小周单休）"/>
                                <ComboBoxItem Content="待业（每天都是放假）"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="固定额度（分钟 / 夜）"
                                       Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtFixed" Grid.Row="1" Grid.Column="1"
                                     Height="30" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="附加池（分钟 / 周）"
                                       Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtPool" Grid.Row="2" Grid.Column="1"
                                     Height="30" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="宽松夜系数（0.1 ~ 1.0）"
                                       Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtFactor" Grid.Row="3" Grid.Column="1"
                                     Height="30" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="紧张夜单夜封顶（分钟）"
                                       Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtCapWork" Grid.Row="4" Grid.Column="1"
                                     Height="30" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="宽松夜单夜封顶（分钟）"
                                       Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtCapRelax" Grid.Row="5" Grid.Column="1"
                                     Height="30" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <CheckBox x:Name="chkOverdraft" Grid.Row="6" Grid.Column="1"
                                      Content="附加池耗尽后允许透支（透支额转为债务）"
                                      Foreground="White" FontSize="13" Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="tbLock"
                   Grid.Row="2"
                   Foreground="#9E9E9E"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnOk" Content="确定" Width="90" Height="38" Margin="0,0,10,0"
                    IsDefault="True"
                    Foreground="White" Background="#1565C0" BorderBrush="#0D47A1" BorderThickness="1"
                    Cursor="Hand" Click="Ok_Click"/>
            <Button x:Name="btnCancel" Content="取消" Width="90" Height="38"
                    IsCancel="True"
                    Foreground="White" Background="#37474F" BorderBrush="#546E7A" BorderThickness="1"
                    Cursor="Hand" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
