<Window x:Class="SleepReminder.SnoozeSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置延后时长" 
        Height="220" Width="320" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="选择延后分钟数（5~15分钟）" 
                       FontSize="14" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            <ComboBox x:Name="cmbMinutes" 
                      Width="100" Height="30" 
                      HorizontalAlignment="Center" 
                      FontSize="16" 
                      IsEditable="False"
                      SelectedIndex="5"/>
            <!-- 默认选中10（索引5） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="确定" Width="80" Margin="5" IsDefault="True" Click="OkButton_Click"/>
                <Button Content="取消" Width="80" Margin="5" IsCancel="True" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>