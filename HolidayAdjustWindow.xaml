<Window x:Class="SleepReminder.HolidayAdjustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="假期调休确认"
        Width="470" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="tbIntro"
                   Grid.Row="0"
                   Foreground="#ffcc00"
                   FontSize="16"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Background="#242424"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel x:Name="spDays"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2"
                   Foreground="#aaaaaa"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Text="勾选 = 按“休息”处理；取消勾选 = 按“上班”处理。确认后程序会记住这次选择，之后不再重复询问这段假期。"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="btnAll" Content="全选" Width="80" Height="36" Margin="0,0,8,0"
                    Foreground="White" Background="#37474F" BorderBrush="#546E7A" BorderThickness="1"
                    Cursor="Hand" Click="All_Click"/>
            <Button x:Name="btnNone" Content="全不选" Width="80" Height="36" Margin="0,0,8,0"
                    Foreground="White" Background="#37474F" BorderBrush="#546E7A" BorderThickness="1"
                    Cursor="Hand" Click="None_Click"/>
            <Button x:Name="btnLegal" Content="按法定全放" Width="120" Height="36" Margin="0,0,8,0"
                    Foreground="White" Background="#2E7D32" BorderBrush="#1B5E20" BorderThickness="1"
                    Cursor="Hand" Click="Legal_Click"/>
            <Button x:Name="btnOk" Content="确认" Width="80" Height="36"
                    Foreground="White" Background="#1565C0" BorderBrush="#0D47A1" BorderThickness="1"
                    Cursor="Hand" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
